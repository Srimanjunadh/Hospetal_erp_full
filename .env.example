# ==========================================
# MediClues+ Environment Variables
# ==========================================

# ------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------

# Database Connection (Default uses local SQLite)
# For PostgreSQL use: postgresql+asyncpg://user:password@localhost/dbname
DATABASE_URL=sqlite+aiosqlite:///./medclues.db

# Security
SECRET_KEY=your_super_secret_key_here
ALGORITHM=HS256

# AI Integration
MISTRAL_API_KEY=your_mistral_api_key_here

# Email Service (Brevo/Sendinblue or Gmail)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_sender_email@example.com
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_app_password

# ------------------------------------------
# PMS Frontend Configuration (Vite)
# ------------------------------------------

# Backend Connection
VITE_BACKEND_PORT=8000
VITE_BACKEND_URL=http://localhost:8000

# Payment Gateway
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id

# Firebase Authentication Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ------------------------------------------
# Main Frontend Configuration (Next.js)
# ------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_PMS_URL=http://localhost:5173
