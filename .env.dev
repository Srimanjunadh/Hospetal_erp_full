# ==========================================
# MediClues+ Development Environment Variables
# ==========================================

# Database Connection (Default uses local SQLite volume in dev)
DATABASE_URL=sqlite+aiosqlite:////workspace/data/medclues.db

# Message Broker
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Security
SECRET_KEY=your_development_secret_key_here
ALGORITHM=HS256

# AI Integration
MISTRAL_API_KEY=your_mistral_api_key_here

# Email Service (Brevo SMTP Relay)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=adec15001@smtp-brevo.com
EMAIL_APP_PASSWORD=your_brevo_app_password_here
BREVO_SENDER_EMAIL=adec15001@smtp-brevo.com

# Gateway Allowed Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175
